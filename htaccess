Options -MultiViews
RewriteEngine On

# 1. Redirecionamento HTTPS + WWW
# (se usar Cloudflare ou proxy e ocorrer loop de redirecionamento, troque
#  a condição %{HTTPS} off por: RewriteCond %{HTTP:X-Forwarded-Proto} !https)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\.djautumn\.com\.br$ [NC]
RewriteRule ^(.*)$ https://www.djautumn.com.br/$1 [L,R=301]

# 2. Tipos MIME (garante que fontes e áudio sejam reconhecidos pelo cache)
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType font/woff  .woff
  AddType image/webp .webp
  AddType audio/mpeg .mp3
</IfModule>

# 3. Cache de recursos
<IfModule mod_expires.c>
  ExpiresActive On

  # Imagens - 1 ano
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType image/jpg              "access plus 1 year"
  ExpiresByType image/jpeg             "access plus 1 year"
  ExpiresByType image/gif              "access plus 1 year"
  ExpiresByType image/webp             "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 1 year"
  ExpiresByType image/x-icon           "access plus 1 year"

  # CSS e JS - 1 mês
  ExpiresByType text/css               "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript        "access plus 1 month"

  # Fontes - 1 ano
  ExpiresByType font/woff2             "access plus 1 year"
  ExpiresByType font/woff              "access plus 1 year"

  # Áudio - 1 mês
  ExpiresByType audio/mpeg             "access plus 1 month"
</IfModule>

# 4. Cabeçalhos de cache
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "max-age=2592000, public"
  </FilesMatch>

  <FilesMatch "\.(png|jpg|jpeg|gif|webp|svg|ico|woff|woff2)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>

  <FilesMatch "\.(mp3)$">
    Header set Cache-Control "max-age=2592000, public"
  </FilesMatch>
</IfModule>

# 5. Compressão GZIP (melhora velocidade)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
